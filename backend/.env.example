PORT=4000
NODE_ENV=development

# Supabase (service role só no backend — nunca no frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Cloud API
WHATSAPP_TOKEN=your-whatsapp-permanent-or-temp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_APP_ID=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_WABA_ID=
# Tarifa em BRL por mensagem paga (estimativa do card de consumo quando a Meta devolve custo 0)
META_PRICE_SERVICE=0.035

# OpenAI — usado só no bot v2 (simplificado), para interpretar o pedido digitado
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Transcrição dos áudios dos clientes (v2)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# false = não guarda as chamadas nos Logs da OpenAI
OPENAI_STORE_LOGS=true
# Admin key (sk-admin-...) só para exibir consumo/custos em Configurações. Nunca coloque o valor aqui.
OPENAI_ADMIN_KEY=
# Opcional: mostra só o consumo deste projeto (proj_...)
OPENAI_PROJECT_ID=

# Origem do painel em produção (Railway). Separe por vírgula se houver mais de uma.
FRONTEND_ORIGIN=

# Estabelecimento padrão (uuid gerado no seed do Supabase)
DEFAULT_STORE_ID=00000000-0000-0000-0000-000000000001
