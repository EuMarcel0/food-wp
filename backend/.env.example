PORT=4000
NODE_ENV=development

# Supabase (service role só no backend — nunca no frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Cloud API
WHATSAPP_TOKEN=your-whatsapp-permanent-or-temp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_GRAPH_VERSION=v21.0

# Estabelecimento padrão (uuid gerado no seed do Supabase)
DEFAULT_STORE_ID=00000000-0000-0000-0000-000000000001
